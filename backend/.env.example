# ===========================================================================
# Fast Sold LLC — Laravel API environment
#
# Copy to `.env` and fill in. This file contains PLACEHOLDERS ONLY — never
# commit a real .env, a database password, or an application key.
#
# In production these values come from Hostinger's environment variable
# settings, not from a file in the repository. See docs/DEPLOYMENT.md.
# ===========================================================================

APP_NAME="Fast Sold LLC"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Origin(s) allowed to call this API, comma-separated. Used by config/cors.php.
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — PostgreSQL
#
# The application targets PostgreSQL in every environment. In production the
# database is Supabase PostgreSQL, configured through Hostinger's environment
# variables; `DB_SSLMODE=require` is mandatory there.
#
# Nothing needs a database until you run migrations: the frontend can be
# developed against bundled demo data (NEXT_PUBLIC_DEMO_MODE=true), and the
# test suite runs on an in-memory SQLite database.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fastsold
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer

# ---------------------------------------------------------------------------
# Sessions, cache, queue
#
# The API is stateless and token-authenticated, so the session driver only
# matters for the framework's own internals.
# ---------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# ---------------------------------------------------------------------------
# Sanctum
#
# Stateful domains are intentionally empty: authentication is a bearer token,
# not a session cookie, so there is no cross-site cookie to protect.
# ---------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=

# ---------------------------------------------------------------------------
# Mail — used for user invitations and password resets
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
