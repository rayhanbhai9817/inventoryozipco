# ---------------------------------------------------------------------------
# Fast Sold LLC — Frontend environment
# Copy to `.env.local` and adjust. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Base URL of the Laravel REST API (no trailing slash beyond the version prefix).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Public application name / marketing copy hooks.
NEXT_PUBLIC_APP_NAME="Fast Sold LLC"

# Set to "true" to render the dashboard with bundled demo data instead of
# calling the Laravel API. This exists only so the UI can be developed and
# reviewed before the production database is connected. It must be "false"
# in production.
NEXT_PUBLIC_DEMO_MODE=true
